      },
      "fields": [
        {
          "key": "list",
          "type": "select",
          "required": false,
          "label": {
            "en": "List",
            "fr": "Liste"
          },
          "description": {
            "en": "Leave empty for both.",
            "fr": "Laissez vide pour les deux."
          },
          "options": [
            {
              "value": "owned",
              "label": {
                "en": "Collection",
                "fr": "Collection"
              }
            },
            {
              "value": "wanted",
