{
  "manifest_version": 1,
  "type": "device",
  "name": "JewelBox",
  "description": {
    "en": "Your JewelBox CD collection in Gladys: counters, loans, widgets, scenes, players under control.",
    "fr": "Votre collection de CD JewelBox dans Gladys : compteurs, prêts, widgets, scènes, lecteurs pilotés."
  },
  "version": "0.4.0",
  "docker_image": "ghcr.io/william-de71/gladys-jewelbox:0.4.0",
  "gladys_version": ">=5.3.0",
  "categories": ["multimedia"],
  "keywords": [
    "CD",
    "collection de CD",
    "CD collection",
    "music library",
    "discothèque",
    "prêt de CD",
    "album",
    "lecteur audio"
  ],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-jewelbox/main/cover.jpg",
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "mdns",
      "service": "_jewelbox._tcp"
    }
  ],
  "music": {
    "browse": true,
    "search": true,
    "queue": true,
    "append": true
  },
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Before you start",
        "fr": "Avant de commencer"
      },
      "description": {
        "en": "JewelBox Music Library is found on the local network by itself (mDNS, “_jewelbox._tcp”): leave the address empty, save, then use “Test the connection”. Type the address only if JewelBox is not found, for example when it runs in Docker without “network_mode: host” (multicast does not cross the Docker bridge). Nothing leaves the local network.",
        "fr": "JewelBox Music Library est trouvé tout seul sur le réseau local (mDNS, « _jewelbox._tcp ») : laissez l’adresse vide, enregistrez, puis utilisez « Tester la connexion ». Saisissez l’adresse seulement si JewelBox n’est pas trouvé, par exemple s’il tourne dans Docker sans « network_mode: host » (le multicast ne traverse pas le pont Docker). Rien ne sort du réseau local."
      },
      "links": [
        {
          "url": "https://github.com/William-De71/Jewelbox-Music-Library",
          "label": {
            "en": "JewelBox Music Library",
            "fr": "JewelBox Music Library"
          }
        }
      ]
    },
    {
      "key": "server_url",
      "type": "string",
      "required": false,
      "label": {
        "en": "Server address (optional)",
        "fr": "Adresse du serveur (facultatif)"
      },
      "placeholder": {
        "en": "http://192.168.1.10:3001",
        "fr": "http://192.168.1.10:3001"
      },
      "description": {
        "en": "Empty: found by mDNS. A host alone gets http:// and port 3001.",
        "fr": "Vide : trouvé par mDNS. Un nom d’hôte seul reçoit http:// et le port 3001."
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "required": false,
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes"
      },
      "description": {
        "en": "Language of the device and feature names, of the status messages and of the texts the scene actions return (Gladys does not tell the integration the language of the user).",
        "fr": "Langue des noms d’appareils et de fonctionnalités, des messages d’état et des textes renvoyés par les actions de scène (Gladys ne transmet pas la langue de l’utilisateur à l’intégration)."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "loan_reminder_days",
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 365,
      "required": false,
      "label": {
        "en": "Loan reminder (days)",
        "fr": "Rappel de prêt (jours)"
      },
      "description": {
        "en": "A loan older than this fires the “Loan overdue” trigger, once per loan, and shows in orange in the Loans widget.",
        "fr": "Un prêt plus ancien déclenche « Prêt en retard », une fois par prêt, et s’affiche en orange dans le widget Prêts."
      }
    },
    {
      "key": "players_max_age_days",
      "type": "number",
      "default": 90,
      "min": 1,
      "max": 3650,
      "required": false,
      "label": {
        "en": "Players shown (days)",
        "fr": "Lecteurs proposés (jours)"
      },
      "description": {
        "en": "The Discover tab offers the players used in the last days only (an old browser keeps its queue for ever).",
        "fr": "L’onglet Découverte ne propose que les lecteurs utilisés ces derniers jours (un vieux navigateur garde sa file pour toujours)."
      }
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "description": {
        "en": "Finds the JewelBox server, reads the collection and the players, and refreshes the Discover tab.",
        "fr": "Cherche le serveur JewelBox, lit la collection et les lecteurs, et met à jour l’onglet Découverte."
      }
    }
  ],
  "widgets": [
    {
      "key": "now_playing",
      "icon": "music",
      "label": {
        "en": "JewelBox player",
        "fr": "Lecteur JewelBox"
      },
      "description": {
        "en": "The track a JewelBox player plays, with its cover.",
        "fr": "Le titre que lit un lecteur JewelBox, avec sa pochette."
      },
      "settings": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "required": false,
          "label": {
            "en": "Player",
            "fr": "Lecteur"
          },
          "description": {
            "en": "A JewelBox player created in Gladys. Leave empty for the one playing (or the last one used).",
            "fr": "Un lecteur JewelBox créé dans Gladys. Laissez vide pour celui qui joue (ou le dernier utilisé)."
          }
        }
      ]
    },
    {
      "key": "collection",
      "icon": "disc",
      "label": {
        "en": "CD collection",
        "fr": "Collection de CD"
      },
      "description": {
        "en": "Albums, wish list, loans, artists, hours of music, albums by decade and top genres.",
        "fr": "Albums, liste de souhaits, prêts, artistes, heures de musique, albums par décennie et genres phares."
      }
    },
    {
      "key": "loans",
      "icon": "share-2",
      "label": {
        "en": "Lent albums",
        "fr": "Albums prêtés"
      },
      "description": {
        "en": "Who has which album, since when.",
        "fr": "Qui a quel album, depuis quand."
      }
    },
    {
      "key": "album_of_the_day",
      "icon": "sun",
      "label": {
        "en": "Album of the day",
        "fr": "Album du jour"
      },
      "description": {
        "en": "The suggestion of the day of JewelBox, or another album drawn at random.",
        "fr": "La suggestion du jour de JewelBox, ou un autre album tiré au hasard."
      },
      "action_timeout_seconds": 15
    },
    {
      "key": "recently_added",
      "icon": "plus-circle",
      "label": {
        "en": "Recently added",
        "fr": "Derniers ajouts"
      },
      "description": {
        "en": "The covers of the latest albums added.",
        "fr": "Les pochettes des derniers albums ajoutés."
      },
      "settings": [
        {
          "key": "list",
          "type": "select",
          "default": "all",
          "required": false,
          "label": {
            "en": "Albums",
            "fr": "Albums"
          },
          "options": [
            {
              "value": "all",
              "label": {
                "en": "Collection and wish list",
                "fr": "Collection et liste de souhaits"
              }
            },
            {
              "value": "owned",
              "label": {
                "en": "Collection only",
                "fr": "Collection seulement"
              }
            },
            {
              "value": "wanted",
              "label": {
                "en": "Wish list only",
                "fr": "Liste de souhaits seulement"
              }
            }
          ]
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "album_added",
      "label": {
        "en": "JewelBox: album added",
        "fr": "JewelBox : album ajouté"
      },
      "description": {
        "en": "An album is added to the collection or to the wish list, or a wished album joins the collection. Checked every minute.",
